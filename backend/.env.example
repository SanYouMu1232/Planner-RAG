# Backend
DATABASE_URL=sqlite+aiosqlite:///./planner.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./storage/uploads
UPLOAD_TEMP_DIR=./storage/tmp
MAX_UPLOAD_MB=80
INGESTION_MODE=background
REQUEST_TIMEOUT_SECONDS=35
LLM_MAX_TOKENS=8192

# No local OCR is configured or bundled. Configure Baidu Cloud OCR in the UI only
# after confirming that selected source files will be transferred to Baidu Cloud.

# LLM (can alternatively be saved through the UI)
LLM_PROVIDER=DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Deterministic local embeddings make the project runnable for demos/tests.
# Replace with a production embedding service before production deployment.
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL_ID=stub-embedding-v1
EMBEDDING_DIMENSION=768
EMBEDDING_VERSION=1.0.0
ALLOW_STUB_EMBEDDING=1

# Optional default web-search values. The UI supports Bocha, Tavily, Serper,
# SerpApi, SearXNG and Brave, and tests each configuration with a real request.
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_BASE_URL=

# Used to encrypt saved provider API keys in local SQLite.
# Change before non-demo deployment and keep it outside version control.
PROVIDER_CONFIG_SECRET=change-this-before-real-deployment
